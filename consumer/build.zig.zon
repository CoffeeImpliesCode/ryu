.{
    .name = .ryu_consumer,
    .version = "0.1.0",
    // Separate from the library's own fingerprint because this is a different
    // package with a different name. It exists to prove that the library's
    // published module can be consumed by a package that did not write it.
    .fingerprint = 0x9e399d4789591a97, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // A relative path, not a registry or archive URL. The consumer is the
        // proof that `dep.module("ryu")` works from outside the package that
        // defines it; resolving that through the network would make the proof
        // depend on the published state of the world instead.
        .ryu = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
